modules = ["nodejs-24"]
run = "npm run dev -- -H 0.0.0.0 -p 3000"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start", "--", "-H", "0.0.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- -H 0.0.0.0 -p 3000"
waitForPort = 3000

[[workflows.workflow]]
name = "arc-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "ARC_TEST_URL=http://localhost:3000 npm run test:arc"

[workflows.workflow.metadata]
isValidation = true

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
